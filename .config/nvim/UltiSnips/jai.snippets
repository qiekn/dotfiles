## global

# notes:
# - snip.rv means 'Snippet Return Value'
# - `!p <your python code here>`

global !p
from jai import jai_debug_call
from jai import jai_type_of
from jai import jai_defer
from jai import jai_inline
from jai import jai_postfix_cast
endglobal

## import

snippet ip "import" bA
#import "$0";
endsnippet

snippet import "import" b
#import "$1";
$0
endsnippet

## function

snippet func "function" b
${1:func_name } :: () {
	$0
}
endsnippet

snippet "(\w+)\*\*" "function" rA
`!p snip.rv = match.group(1)` :: () {
	$0
}
endsnippet

snippet "(\w+)fn" "function" rA
`!p snip.rv = match.group(1)` :: () {
	$0
}
endsnippet

## ;commands

snippet ";(to|return)" "=>" rwA
=>
endsnippet

snippet ;add "" wA
+
endsnippet

snippet ;sub "" wA
-
endsnippet

snippet ";(ld|load)" "=>" rwA
#load "$0"
endsnippet

snippet ";var|mk" "jai variable declaration" brA
${1:name} := ${2:value};$0
endsnippet

snippet "md" "jai variable declaration" brA
${1:name}: ${2:type} = ${3:value};$0
endsnippet

## `#` snippets

snippet #bake_arguments "" w
#bake_arguments
endsnippet

# script
snippet "(;jai|##|!!)" "#!/bin/env jai" brA
#!/bin/env jai
endsnippet

## hepler functions
snippet "(hs|phs)" "hello sailer" brA
print("Hello, Sailer!\n");
endsnippet

# print
snippet "(print\(|pt)" "print()" brA
print("$0");
endsnippet

snippet section "Section" b
print("--------------------: $0\n");
endsnippet

#snippet "(\w+);print" "print variable" rA
#print("`!p snip.rv = match.group(1)`=%\n", `!p snip.rv = match.group(1)`);
#endsnippet

snippet "^(\s*)([^;]+);(pt|print)" "print variables" brA
`!p snip.rv = match.group(1) + jai_debug_call("print", match.group(2))`
endsnippet

snippet "^(\s*)([^;]+);log" "log variables" brA
`!p snip.rv = match.group(1) + jai_debug_call("log", match.group(2))`
endsnippet

snippet "^(\s*)([^;]+);type" "print type_of" brA
`!p snip.rv = match.group(1) + jai_type_of(match.group(2))`
endsnippet

snippet "^(\s*)(.+);defer" "defer current statement" brA
`!p snip.rv = match.group(1) + jai_defer(match.group(2))`
endsnippet

snippet "^(\s*)(.+);inline" "inline current statement" brA
`!p snip.rv = match.group(1) + jai_inline(match.group(2))`
endsnippet

# ;fn     -> no args, no return
# a;fn    -> args, no return
# r;fn    -> no args, return
# ar;fn   -> args, return

snippet ;fn "function" bA
${1:name} :: () {
	$0
}
endsnippet

snippet a;fn "function arguments" bA
${1:name} :: (${2:args}) {
	$0
}
endsnippet

snippet r;fn "function return" bA
${1:name} :: () -> ${2:int} {
	$0
}
endsnippet

snippet ar;fn "function arguments return" bA
${1:name} :: (${2:args}) -> ${3:int} {
	$0
}
endsnippet

# struct
snippet ;st "struct" bA
${VISUAL:MyStruct} :: struct {
	$0
}
endsnippet

snippet "(\w+);st" "struct" brA
`!p snip.rv = match.group(1)` :: struct {
	$0
}
endsnippet

# from: b = a;cast
#   to: b = cast($0) a;
snippet "^(\s*)(.*);cast" "postfix cast" rA
`!p
lhs, prefix, expr = jai_postfix_cast(match.group(2), "cast")
snip.rv = match.group(1) + lhs + prefix
`${1:u16}) `!p
lhs, prefix, expr = jai_postfix_cast(match.group(2), "cast")
snip.rv = expr
`;$0
endsnippet

snippet ;main "jai main" bA
#import "Basic";

main :: () {
	$0
}
endsnippet

## scope identifiers
snippet smodule "" bA
#scope_module
endsnippet

snippet fmodule "" bA
#file_module
endsnippet

snippet #load "#load" bA
#load "$0";
endsnippet

# -----------------------------------------------------------------------------: first.jai

snippet ;first "first.jai" bA
OUTPUT_EXECUTABLE_NAME :: "${1:${VISUAL:app}}";
OUTPUT_DIRECTORY :: "bin";
$0
#run {
	w := compiler_create_workspace("Jail");
	if !w {
		write_string("The world is not ready for jai!\n");
		return;
	}

	options := get_build_options(w);

	options.output_executable_name = OUTPUT_EXECUTABLE_NAME;
	options.output_path = OUTPUT_DIRECTORY;
	if !make_directory_if_it_does_not_exist(OUTPUT_DIRECTORY) {
		log(tprint("Could not create output directory %.", OUTPUT_DIRECTORY));
		return;
	}

	set_build_options(options, w);

	add_build_file("src/main.jai", w);

	set_build_options_dc(.{do_output=false});
}

#import "Compiler";
#import "Basic";
#import "File";
endsnippet

# -----------------------------------------------------------------------------: first.jai alt
snippet ;jail "first.jai" b
#!/bin/env jai

#import "Compiler";
#import "Basic";
#import "Process";

our_debug_version_compilation_finished := false;
are_we_building_release_version        := false;

#run build();

build :: () {
	set_build_options_dc(.{do_output=false});

	// Release build
	for get_toplevel_command_line() {
		if it == {
			case "-o"; #through;
			case "-optimized";
				are_we_building_release_version = true;
				build_release();
		}
	}

	// Debug build
	if !are_we_building_release_version then build_debug();
}

start_a_workspace :: (name: string, procedure: (w: Workspace)) {
	w := compiler_create_workspace(name);
	if !w {
		log_error("Failed to create workspace '%'", name);
		return;
	}

	procedure(w);
}

setup_debug :: (w: Workspace) {
	options := get_build_options(w);

	set_optimization(*options, .DEBUG);

	options.output_executable_name = "game_debug";
	options.output_path            = tprint("%/run_tree/", #filepath);
	options.backend                = .X64;
	options.text_output_flags      = 0;
	options.emit_debug_info        = .NONE;

	set_build_options(options, w);

	compiler_begin_intercept(w);
	add_build_file("src/main.jai", w);
	message_loop();
	compiler_end_intercept(w);

	if our_debug_version_compilation_finished {
		log("\nRuning our program...");

		result := run_command("./run_tree/game_debug");

		log("Our program exited with code %\n\n", result.exit_code);
	}
}

setup_release :: (w: Workspace) {
	options := get_build_options(w);

	set_optimization(*options, .OPTIMIZED);

	options.output_executable_name = "game";
	options.output_path            = tprint("%/run_tree/", #filepath);
	options.backend                = .LLVM;
	options.text_output_flags      = 0;
	options.emit_debug_info        = .NONE;

	set_build_options(options, w);

	add_build_file("src/main.jai", w);
}

build_debug   :: () { start_a_workspace("Debug",   setup_debug);   }
build_release :: () { start_a_workspace("Release", setup_release); }

message_loop :: () {
	while true {
		message := compiler_wait_for_message();
		if !message break;

		if message.kind == .COMPLETE {
			complete := cast(*Message_Complete) message;
			our_debug_version_compilation_finished = complete.error_code == 0;
			break;
		}
	}
}
endsnippet

snippet ;output "do_output=false" bA
set_build_options_dc(.{do_output=false});
endsnippet

# vim: ts=2
